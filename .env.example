# ==============================================================================
# SMARTSTOCK ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and configure credentials. Never commit real keys.
# ==============================================================================

# 1. API & Security Configuration
API_TITLE="Supply Chain Demand & Inventory Optimization Engine"
API_VERSION="1.0.0"
API_KEY="" # Optional: set a secret string to require X-API-Key header on analytical routes
GEMINI_API_KEY="" # Server-side Gemini API key (never expose to client browser)
ALLOWED_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]'
PORT=8000
HOST="0.0.0.0"

# 2. Supabase Cloud Database & Auth Configuration
# Obtain from your Supabase Dashboard: https://supabase.com/dashboard/project/<ref>/settings/api
SUPABASE_URL="https://txpvoqdecsjpmklelxdb.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# 3. Model & SQLite Analytical Database Paths
DB_PATH="data/supply_chain.db"
MODEL_PATH="artifacts/rf_model.joblib"
METRICS_PATH="artifacts/metrics.json"
SEGMENTS_PATH="artifacts/segments.json"
